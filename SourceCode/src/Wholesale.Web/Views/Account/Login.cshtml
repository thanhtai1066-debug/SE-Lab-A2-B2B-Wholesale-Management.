@model LoginVm
@{ ViewData["Title"] = "Agent Login"; }
<section class="auth-card">
  <h1>Agent sign in</h1>
  <p class="muted">For registered wholesale agents only.</p>
  <form asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="UserName" class="form-label">Username</label><input asp-for="UserName" class="form-control" autocomplete="username" /></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" /></div>
    <button type="submit" class="btn btn-primary full-width">Sign in</button>
  </form>
  <p class="mt-3 muted"><small>Local demo: <code>agent01</code> / <code>Agent@@12345!</code>. Never use demo passwords online.</small></p>
</section>
