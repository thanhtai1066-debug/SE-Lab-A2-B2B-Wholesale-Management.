<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Wholesale Agent Portal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-head no-print">
<nav class="container nav-wrap" aria-label="Main navigation">
  <a class="brand" asp-controller="Catalog" asp-action="Index">📦 Wholesale Portal</a>
  <div class="nav-links">
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Agent"))
    {
        <a asp-controller="Catalog" asp-action="Index">🛒 Catalog</a>
        <a asp-controller="Orders" asp-action="Create">✚ Place Order</a>
        <a asp-controller="Orders" asp-action="Mine">📄 My Orders</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout">
          @Html.AntiForgeryToken()
          <button class="nav-button" type="submit">Log out (@User.Identity.Name)</button>
        </form>
    }
    else { <a asp-controller="Account" asp-action="Login">Login</a> }
  </div>
</nav>
</header>
<main class="container main-content">
  @if (TempData["Success"] is string ok) { <div class="alert alert-success no-print" role="status">@ok</div> }
  @RenderBody()
</main>
<footer class="container footer no-print">SE Lab Assignment 2 • Demo wholesale ordering system</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
