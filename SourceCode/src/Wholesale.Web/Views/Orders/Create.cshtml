@model OrderEntryVm
@{ ViewData["Title"] = "Place Wholesale Order"; }
<div class="heading-row"><div><h1>New wholesale order</h1><p class="muted">Enter quantities for one or more products. The database transaction prevents partial orders.</p></div><a asp-action="Mine">My orders</a></div>
<form asp-action="Create" method="post" class="panel">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Product</th><th>Pack / size</th><th class="right">Price (VND)</th><th class="right">Stock</th><th style="width:140px">Order quantity</th></tr></thead>
      <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
          <tr>
            <td><strong>@Model.Lines[i].ItemName</strong><input type="hidden" asp-for="Lines[i].ItemId" /></td>
            <td>@Model.Lines[i].Size</td>
            <td class="right">@Model.Lines[i].Price.ToString("N0")</td>
            <td class="right">@Model.Lines[i].StockQuantity</td>
            <td><input asp-for="Lines[i].Quantity" type="number" min="0" max="100000" class="form-control" aria-label="Quantity for @Model.Lines[i].ItemName" /></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  <div class="d-flex gap-2 align-items-center justify-content-end"><span class="muted">Prices and stock are verified on the server when submitted.</span><button type="submit" class="btn btn-primary">Place order</button></div>
</form>
